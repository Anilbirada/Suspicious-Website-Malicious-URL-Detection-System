# Suspicious Website / Malicious URL Detection System - Environment Configuration
# Copy this file to .env and adjust values as needed. Never commit real secrets.

APP_NAME="Suspicious Website / Malicious URL Detection System"
APP_ENV="development"
APP_VERSION="1.0.0"
DEVELOPER_NAME="Anil Biradar"

# Server & CORS
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Security & Rate Limiting
MAX_URL_LENGTH=2048
MAX_REQUEST_BYTES=16384
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Privacy & Persistence
ENABLE_HISTORY=true
DATABASE_URL="sqlite:///./url_analysis.db"
STORE_RAW_URL_IN_HISTORY=true

# Machine Learning & Fallback Configuration
MODEL_ARTEFACT_PATH="backend/app/ml/artefacts/url_model_v1.joblib"
ALLOW_FALLBACK_MODE=true
